{
  "name": "bookstack-playwright-allure",
  "version": "1.0.0",
  "description": "Playwright + Allure UI automation for BookStack Demo",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm run report:generate && npm run report:open"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "allure-playwright": "^3.0.0",
    "allure-commandline": "^2.30.0",
    "@types/node": "^20.0.0"
  }
}
